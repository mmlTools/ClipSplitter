<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ClipSplitterApp.Views"
        x:Class="ClipSplitterApp.Views.MainWindow"
        x:DataType="views:MainWindow"
        Title="ClipSplitter - Video Segment Exporter"
        Width="1280" Height="820"
        MinWidth="900" MinHeight="620"
        Background="#0E1118"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="0">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.window-control">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#CBD5E1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.window-control:pointerover">
      <Setter Property="Background" Value="#202838" />
    </Style>
    <Style Selector="Button.close-control:pointerover">
      <Setter Property="Background" Value="#C2413D" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.action-button">
      <Setter Property="MinWidth" Value="104" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="#202838" />
      <Setter Property="Foreground" Value="#E5ECF7" />
      <Setter Property="BorderBrush" Value="#344052" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.action-button:pointerover">
      <Setter Property="Background" Value="#2A3447" />
      <Setter Property="BorderBrush" Value="#4B5C76" />
    </Style>
    <Style Selector="Button.action-button:pressed">
      <Setter Property="Background" Value="#18202E" />
    </Style>
    <Style Selector="TextBox, NumericUpDown">
      <Setter Property="Background" Value="#10141c" />
      <Setter Property="Foreground" Value="#edf2f7" />
      <Setter Property="BorderBrush" Value="#2f394a" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TextBox:pointerover, NumericUpDown:pointerover">
      <Setter Property="BorderBrush" Value="#46566f" />
    </Style>
    <Style Selector="TextBox:focus, NumericUpDown:focus">
      <Setter Property="BorderBrush" Value="#3b82f6" />
    </Style>
    <Style Selector="Button.preview-button">
      <Setter Property="Width" Value="88" />
      <Setter Property="MinWidth" Value="88" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#2563eb" />
      <Setter Property="BorderBrush" Value="#3b82f6" />
      <Setter Property="Foreground" Value="#ffffff" />
    </Style>
    <Style Selector="Button.accent:pointerover">
      <Setter Property="Background" Value="#1d4ed8" />
      <Setter Property="BorderBrush" Value="#60a5fa" />
    </Style>
    <Style Selector="Border.resize-horizontal">
      <Setter Property="Cursor" Value="SizeWestEast" />
    </Style>
    <Style Selector="Border.resize-vertical">
      <Setter Property="Cursor" Value="SizeNorthSouth" />
    </Style>
    <Style Selector="Border.resize-nwse">
      <Setter Property="Cursor" Value="TopLeftCorner" />
    </Style>
    <Style Selector="Border.resize-nesw">
      <Setter Property="Cursor" Value="TopRightCorner" />
    </Style>
  </Window.Styles>

  <Grid>
    <Grid RowDefinitions="38,*" Margin="6">
      <Border x:Name="TitleBar"
              Grid.Row="0"
              Background="#0E1118"
              PointerPressed="TitleBar_PointerPressed">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="10,0,0,0">
            <TextBlock Text="CS" FontSize="11" FontWeight="Bold" Foreground="#9CB7FF" VerticalAlignment="Center" />
            <TextBlock Text="ClipSplitter - Video Segment Exporter" Opacity=".78" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
            <Button Classes="window-control" Click="OpenFfmpegDownload_Click" ToolTip.Tip="Download FFmpeg">
              <TextBlock Text="↓" FontSize="13" Foreground="#9CB7FF" />
            </Button>
            <Button Classes="window-control" Click="SupportProject_Click" ToolTip.Tip="Support the project">
              <TextBlock Text="♥" FontSize="12" Foreground="#E8394A" />
            </Button>
            <Rectangle Width="1" Height="14" Fill="#33FFFFFF" Margin="4,0" VerticalAlignment="Center" />
            <Button Classes="window-control minimize-control" Content="-" Click="Minimize_Click" ToolTip.Tip="Minimize" />
            <Button Classes="window-control maximize-control" Content="+" Click="MaximizeRestore_Click" ToolTip.Tip="Maximize" />
            <Button Classes="window-control close-control" Content="x" Click="Close_Click" ToolTip.Tip="Close" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="10">
        <Grid ColumnDefinitions="*" ColumnSpacing="12">
          <StackPanel Spacing="8">
            <TextBlock Text="Clip Splitter" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Preview the generated cuts, choose the clips you want, then export only those segments." Opacity="0.75" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,22,0,0" Padding="20" CornerRadius="8" Background="#151922" BorderBrush="#2b3242" BorderThickness="1">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,2*,Auto,*,Auto" ColumnDefinitions="*,Auto" RowSpacing="14" ColumnSpacing="12">
            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Input clip" FontWeight="SemiBold" />
            <TextBox Grid.Row="1" Grid.Column="0" x:Name="InputPathBox" Watermark="Select a video file..." IsReadOnly="True" />
            <Button Grid.Row="1" Grid.Column="1" x:Name="BrowseInputButton" Classes="action-button" Content="Browse clip" Click="BrowseInput_Click" />

            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="Output folder" FontWeight="SemiBold" />
            <TextBox Grid.Row="3" Grid.Column="0" x:Name="OutputPathBox" Watermark="Select output folder..." IsReadOnly="True" />
            <Button Grid.Row="3" Grid.Column="1" x:Name="BrowseOutputButton" Classes="action-button" Content="Browse folder" Click="BrowseOutput_Click" />

            <Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="Auto,120,Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
              <TextBlock Text="Split every" VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="1"
                             x:Name="SegmentSecondsBox"
                             Minimum="1"
                             Maximum="86400"
                             Value="30"
                             Increment="1"
                             ValueChanged="SegmentSecondsBox_ValueChanged" />
              <TextBlock Grid.Column="2" Text="seconds" VerticalAlignment="Center" />
              <CheckBox Grid.Column="3" x:Name="ReencodeCheckBox" Content="Re-encode for exact cuts" VerticalAlignment="Center" />
              <Button Grid.Column="4" x:Name="SplitButton" Classes="accent action-button" Content="Export selected" Click="Split_Click" />
            </Grid>

            <Grid Grid.Row="5" Grid.ColumnSpan="2" RowDefinitions="Auto,*" RowSpacing="10">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="Cut preview" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="PreviewSummaryText" Opacity="0.65" VerticalAlignment="Center" />
                <Button Grid.Column="2" x:Name="SelectAllButton" Classes="action-button" Content="Select all" Click="SelectAll_Click" />
                <Button Grid.Column="3" x:Name="ClearSelectionButton" Classes="action-button" Content="Clear" Click="ClearSelection_Click" />
              </Grid>

              <ListBox Grid.Row="1"
                       x:Name="PreviewList"
                       ItemsSource="{Binding PreviewItems}"
                       Background="#10141c"
                       BorderBrush="#2b3242"
                       BorderThickness="1"
                       CornerRadius="6"
                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="views:ClipPreviewItem">
                    <Grid ColumnDefinitions="Auto,96,80,*,90,160,88" ColumnSpacing="12" Margin="8,6">
                      <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                      <Border Grid.Column="1"
                              Width="96"
                              Height="54"
                              Background="#0b0f16"
                              BorderBrush="#2f394a"
                              BorderThickness="1"
                              CornerRadius="5"
                              ClipToBounds="True">
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                      </Border>
                      <TextBlock Grid.Column="2" Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="3" Text="{Binding TimeRange}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding Duration}" VerticalAlignment="Center" Opacity="0.75" />
                      <TextBlock Grid.Column="5" Text="{Binding FileName}" VerticalAlignment="Center" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="6"
                              Classes="preview-button"
                              Content="{Binding PreviewButtonText}"
                              IsEnabled="{Binding CanPreview}"
                              Click="PreviewClip_Click"
                              VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>

            <ProgressBar Grid.Row="6" Grid.ColumnSpan="2" x:Name="ProgressBar" Minimum="0" Maximum="100" Height="14" />

            <TextBox Grid.Row="7"
                     Grid.ColumnSpan="2"
                     x:Name="LogBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />

            <TextBlock Grid.Row="8" Grid.ColumnSpan="2" Opacity="0.65" Text="Requires ffmpeg and ffprobe in PATH, or in a local tools/ffmpeg folder beside the executable." />
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Classes="resize-vertical" Background="Transparent" Height="8" VerticalAlignment="Top" PointerPressed="ResizeTop_PointerPressed" />
    <Border Classes="resize-vertical" Background="Transparent" Height="8" VerticalAlignment="Bottom" PointerPressed="ResizeBottom_PointerPressed" />
    <Border Classes="resize-horizontal" Background="Transparent" Width="8" HorizontalAlignment="Left" PointerPressed="ResizeLeft_PointerPressed" />
    <Border Classes="resize-horizontal" Background="Transparent" Width="8" HorizontalAlignment="Right" PointerPressed="ResizeRight_PointerPressed" />
    <Border Classes="resize-nwse" Background="Transparent" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" PointerPressed="ResizeTopLeft_PointerPressed" />
    <Border Classes="resize-nesw" Background="Transparent" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" PointerPressed="ResizeTopRight_PointerPressed" />
    <Border Classes="resize-nesw" Background="Transparent" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" PointerPressed="ResizeBottomLeft_PointerPressed" />
    <Border Classes="resize-nwse" Background="Transparent" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" PointerPressed="ResizeBottomRight_PointerPressed" />
  </Grid>
</Window>
