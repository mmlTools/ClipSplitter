<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ClipSplitterApp.Views"
        xmlns:controls="clr-namespace:ClipSplitterApp.Controls"
        xmlns:captions="clr-namespace:ClipSplitterApp.Captions"
        x:Class="ClipSplitterApp.Views.MainWindow"
        x:DataType="views:MainWindow"
        Title="ClipSplitter"
        Width="1280" Height="820"
        MinWidth="1180" MinHeight="700"
        Background="#0E1118"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="0">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Title bar buttons -->
    <Style Selector="Button.window-control">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#CBD5E1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.window-control:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#202838" />
    </Style>
    <Style Selector="Button.close-control:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C2413D" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Buttons -->
    <Style Selector="Button.action-button">
      <Setter Property="MinWidth" Value="104" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="#202838" />
      <Setter Property="Foreground" Value="#E5ECF7" />
      <Setter Property="BorderBrush" Value="#344052" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.action-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2A3447" />
      <Setter Property="BorderBrush" Value="#4B5C76" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.action-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#18202E" />
    </Style>
    <Style Selector="Button.compact">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="BorderBrush" Value="#3B82F6" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1D4ED8" />
      <Setter Property="BorderBrush" Value="#60A5FA" />
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1E40AF" />
    </Style>
    <Style Selector="Button.icon-button">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="#202838" />
      <Setter Property="BorderBrush" Value="#344052" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2A3447" />
      <Setter Property="BorderBrush" Value="#4B5C76" />
    </Style>
    <Style Selector="Button.icon-button.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Inputs -->
    <Style Selector="TextBox, NumericUpDown">
      <Setter Property="Background" Value="#10141C" />
      <Setter Property="Foreground" Value="#EDF2F7" />
      <Setter Property="BorderBrush" Value="#2F394A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TextBox:pointerover, NumericUpDown:pointerover">
      <Setter Property="BorderBrush" Value="#46566F" />
    </Style>
    <Style Selector="TextBox:focus, NumericUpDown:focus">
      <Setter Property="BorderBrush" Value="#3B82F6" />
    </Style>

    <!-- Segmented choices -->
    <Style Selector="RadioButton.segment">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Background" Value="#10141C" />
      <Setter Property="Foreground" Value="#AEB8C7" />
      <Setter Property="BorderBrush" Value="#2F394A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.segment:pointerover">
      <Setter Property="BorderBrush" Value="#46566F" />
      <Setter Property="Foreground" Value="#E5ECF7" />
    </Style>
    <Style Selector="RadioButton.segment:checked">
      <Setter Property="Background" Value="#1B2B4D" />
      <Setter Property="BorderBrush" Value="#3B82F6" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="RadioButton.segment:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- Panels and text -->
    <Style Selector="Border.panel">
      <Setter Property="Padding" Value="16" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="#151922" />
      <Setter Property="BorderBrush" Value="#2B3242" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.slot-row">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="#10141C" />
      <Setter Property="BorderBrush" Value="#2F394A" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#7C8BA3" />
      <Setter Property="LetterSpacing" Value="0.8" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#AEB8C7" />
      <Setter Property="Margin" Value="0,4,0,-2" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#7C8BA3" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="ListBox.clip-list ListBoxItem">
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="ListBox.clip-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#171D29" />
    </Style>
    <Style Selector="ListBox.clip-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1B2B4D" />
    </Style>
    <Style Selector="ListBox.clip-list ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#213560" />
    </Style>

    <!-- Source videos, shown as a row of chips -->
    <Style Selector="ListBox.source-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="ListBox.source-list ListBoxItem">
      <Setter Property="Padding" Value="9,0,3,0" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="#1A2130" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.source-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#222B3D" />
    </Style>
    <Style Selector="ListBox.source-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1D4ED8" />
    </Style>
    <Style Selector="ListBox.source-list ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2563EB" />
    </Style>
    <Style Selector="Button.chip-close">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="MinWidth" Value="20" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chip-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>

    <!-- Drop-down lists -->
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#10141C" />
      <Setter Property="Foreground" Value="#EDF2F7" />
      <Setter Property="BorderBrush" Value="#2F394A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Caption style tiles -->
    <Style Selector="ListBox.style-tiles">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,-6,-6" />
    </Style>
    <Style Selector="ListBox.style-tiles ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="#2F394A" />
      <Setter Property="Background" Value="#10141C" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.style-tiles ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#10141C" />
      <Setter Property="BorderBrush" Value="#46566F" />
    </Style>
    <Style Selector="ListBox.style-tiles ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#10141C" />
      <Setter Property="BorderBrush" Value="#3B82F6" />
    </Style>

    <!-- Caption text, one row per group of words -->
    <Style Selector="ListBox.caption-lines">
      <Setter Property="Background" Value="#10141C" />
      <Setter Property="BorderBrush" Value="#2B3242" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ListBox.caption-lines ListBoxItem">
      <Setter Property="Padding" Value="2" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox.caption-lines ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.caption-lines ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#141B2B" />
    </Style>
    <Style Selector="Button.time-chip">
      <Setter Property="Width" Value="54" />
      <Setter Property="MinWidth" Value="54" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#7C8BA3" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.time-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#202838" />
      <Setter Property="Foreground" Value="#E5ECF7" />
    </Style>
    <Style Selector="TextBox.caption-line">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Colour swatches -->
    <Style Selector="RadioButton.swatch">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel Background="Transparent">
            <Ellipse Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2" />
            <Ellipse Margin="5" Fill="{TemplateBinding Background}" Stroke="#40FFFFFF" StrokeThickness="1" />
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.swatch:pointerover">
      <Setter Property="BorderBrush" Value="#46566F" />
    </Style>
    <Style Selector="RadioButton.swatch:checked">
      <Setter Property="BorderBrush" Value="#3B82F6" />
    </Style>

    <!-- The grips between the three panels: invisible at rest, a thin line under the pointer -->
    <Style Selector="GridSplitter.panel-grip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="SizeWestEast" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent">
            <Border Width="2" CornerRadius="1" Margin="0,8" HorizontalAlignment="Center" Background="{TemplateBinding Background}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="GridSplitter.panel-grip:pointerover">
      <Setter Property="Background" Value="#3B82F6" />
    </Style>

    <!-- Window resize grips -->
    <Style Selector="Border.resize-horizontal">
      <Setter Property="Cursor" Value="SizeWestEast" />
    </Style>
    <Style Selector="Border.resize-vertical">
      <Setter Property="Cursor" Value="SizeNorthSouth" />
    </Style>
    <Style Selector="Border.resize-nwse">
      <Setter Property="Cursor" Value="TopLeftCorner" />
    </Style>
    <Style Selector="Border.resize-nesw">
      <Setter Property="Cursor" Value="TopRightCorner" />
    </Style>
  </Window.Styles>

  <Grid>
    <Grid RowDefinitions="38,*" Margin="6">
      <Border x:Name="TitleBar"
              Grid.Row="0"
              Background="#0E1118"
              PointerPressed="TitleBar_PointerPressed">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="10,0,0,0">
            <TextBlock Text="CS" FontSize="11" FontWeight="Bold" Foreground="#9CB7FF" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText" Text="ClipSplitter" Opacity=".78" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
            <Button Classes="window-control" Click="FfmpegGuide_Click" ToolTip.Tip="How to install FFmpeg" AutomationProperties.Name="How to install FFmpeg">
              <TextBlock Text="↓" FontSize="13" Foreground="#9CB7FF" />
            </Button>
            <Button Classes="window-control" Click="SupportProject_Click" ToolTip.Tip="Support the project">
              <TextBlock Text="♥" FontSize="12" Foreground="#E8394A" />
            </Button>
            <Rectangle Width="1" Height="14" Fill="#33FFFFFF" Margin="4,0" VerticalAlignment="Center" />
            <Button Classes="window-control minimize-control" Content="-" Click="Minimize_Click" ToolTip.Tip="Minimize" />
            <Button Classes="window-control maximize-control" Content="+" Click="MaximizeRestore_Click" ToolTip.Tip="Maximize" />
            <Button Classes="window-control close-control" Content="x" Click="Close_Click" ToolTip.Tip="Close" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Three panels with a grip between each pair. Dragging a grip resizes its neighbours;
           double-clicking one puts all three back to their usual widths. -->
      <Grid Grid.Row="1" x:Name="PanelsGrid" Margin="10,2,10,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="5*" MinWidth="420" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="4*" MinWidth="320" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="320" MinWidth="320" MaxWidth="560" />
        </Grid.ColumnDefinitions>

        <GridSplitter Grid.Column="1"
                      Classes="panel-grip"
                      ResizeDirection="Columns"
                      DoubleTapped="PanelGrip_DoubleTapped"
                      ToolTip.Tip="Drag to resize the panels. Double-click to reset."
                      AutomationProperties.Name="Resize the clip list and the player" />
        <GridSplitter Grid.Column="3"
                      Classes="panel-grip"
                      ResizeDirection="Columns"
                      DoubleTapped="PanelGrip_DoubleTapped"
                      ToolTip.Tip="Drag to resize the panels. Double-click to reset."
                      AutomationProperties.Name="Resize the player and the settings" />

        <!-- Left: the source video and its clips -->
        <Grid Grid.Column="0" RowDefinitions="*,Auto" RowSpacing="12">
          <Border Classes="panel">
            <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="section" Text="SOURCE VIDEOS" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="PreviewSummaryText" FontSize="12" Foreground="#AEB8C7" VerticalAlignment="Center" />
              </Grid>

              <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Border Height="34"
                        Background="#10141C"
                        BorderBrush="#2F394A"
                        BorderThickness="1"
                        CornerRadius="6"
                        ClipToBounds="True">
                  <Panel>
                    <TextBlock x:Name="SourcesEmptyText"
                               Text="Add videos, or drop them here..."
                               Foreground="#7C8BA3"
                               Margin="10,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <ListBox x:Name="SourceList"
                             Classes="source-list"
                             ItemsSource="{Binding Sources}"
                             SelectionChanged="SourceList_SelectionChanged"
                             PointerWheelChanged="SourceList_PointerWheelChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Source videos">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="views:SourceVideo">
                          <StackPanel Orientation="Horizontal" Spacing="4" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" MaxWidth="170" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button Classes="chip-close" Click="RemoveSource_Click" ToolTip.Tip="Remove this video from the list" AutomationProperties.Name="Remove this video">
                              <Path Data="M 0,0 L 7,7 M 7,0 L 0,7" Stroke="#C4CEDC" StrokeThickness="1.3" />
                            </Button>
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Panel>
                </Border>
                <Button Grid.Column="1"
                        x:Name="AddVideosButton"
                        Classes="action-button"
                        MinWidth="0"
                        Content="Add videos"
                        Click="AddVideos_Click"
                        ToolTip.Tip="Load one or more videos. Each keeps its own clip length and its own list of clips." />
                <Button Grid.Column="2"
                        x:Name="ObsButton"
                        Classes="action-button"
                        MinWidth="0"
                        Content="OBS replay"
                        Click="ObsReplay_Click"
                        ToolTip.Tip="Load a replay saved by the replay buffer of OBS Studio" />
              </Grid>

              <Grid Grid.Row="2" ColumnDefinitions="Auto,120,Auto,*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="Split every" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1"
                               x:Name="SegmentSecondsBox"
                               Minimum="1"
                               Maximum="86400"
                               Value="30"
                               Increment="1"
                               FormatString="0"
                               ValueChanged="SegmentSecondsBox_ValueChanged" />
                <TextBlock Grid.Column="2" Text="seconds" VerticalAlignment="Center" />
                <Button Grid.Column="4" x:Name="SelectAllButton" Classes="action-button compact" Content="Select all" Click="SelectAll_Click" />
                <Button Grid.Column="5" x:Name="ClearSelectionButton" Classes="action-button compact" Content="Clear" Click="ClearSelection_Click" />
              </Grid>

              <ListBox Grid.Row="3"
                       x:Name="PreviewList"
                       Classes="clip-list"
                       SelectionChanged="PreviewList_SelectionChanged"
                       Background="#10141C"
                       BorderBrush="#2B3242"
                       BorderThickness="1"
                       CornerRadius="6"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="views:ClipPreviewItem">
                    <Grid ColumnDefinitions="Auto,104,*,Auto"
                          ColumnSpacing="10"
                          Background="Transparent"
                          DoubleTapped="ClipRow_DoubleTapped"
                          PointerPressed="ClipRow_PointerPressed"
                          PointerMoved="ClipRow_PointerMoved"
                          PointerReleased="ClipRow_PointerReleased"
                          PointerCaptureLost="ClipRow_PointerCaptureLost">
                      <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" MinWidth="0" Focusable="False" ToolTip.Tip="Include in Export selected" />
                      <Border Grid.Column="1"
                              Width="104"
                              Height="58"
                              Background="#0B0F16"
                              BorderBrush="#2F394A"
                              BorderThickness="1"
                              CornerRadius="5"
                              ClipToBounds="True">
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                      </Border>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding TimeRange}" FontSize="12" Foreground="#C4CEDC" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Duration}" FontSize="12" Foreground="#7C8BA3" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="icon-button" Click="PlayClip_Click" ToolTip.Tip="Preview this clip" AutomationProperties.Name="Preview this clip">
                          <Path Data="M 0,0 L 9,5.5 L 0,11 Z" Fill="#E5ECF7" Margin="2,0,0,0" />
                        </Button>
                        <Button Classes="icon-button" Click="SendToTop_Click" ToolTip.Tip="Use as the top clip" AutomationProperties.Name="Use as the top clip">
                          <Border Width="11" Height="17" BorderBrush="#9CB7FF" BorderThickness="1.2" CornerRadius="2">
                            <Border VerticalAlignment="Top" Height="7" Background="#9CB7FF" />
                          </Border>
                        </Button>
                        <Button Classes="icon-button" Click="SendToBottom_Click" ToolTip.Tip="Use as the bottom clip" AutomationProperties.Name="Use as the bottom clip">
                          <Border Width="11" Height="17" BorderBrush="#9CB7FF" BorderThickness="1.2" CornerRadius="2">
                            <Border VerticalAlignment="Bottom" Height="7" Background="#9CB7FF" />
                          </Border>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border Grid.Row="1" Classes="panel">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
              <TextBlock Classes="section" Text="EXPORT" />

              <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="OutputPathBox" Watermark="Select output folder..." IsReadOnly="True" />
                <Button Grid.Column="1" x:Name="BrowseOutputButton" Classes="action-button" Content="Browse folder" Click="BrowseOutput_Click" />
              </Grid>

              <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="6">
                <RadioButton x:Name="FormatOriginalRadio"
                             Classes="segment"
                             GroupName="ExportFormat"
                             Content="Original clips"
                             IsChecked="True"
                             IsCheckedChanged="ExportFormat_Changed"
                             ToolTip.Tip="Export each selected clip as it is" />
                <RadioButton Grid.Column="1"
                             x:Name="FormatVerticalRadio"
                             Classes="segment"
                             GroupName="ExportFormat"
                             Content="Shorts (9:16)"
                             IsCheckedChanged="ExportFormat_Changed"
                             ToolTip.Tip="Turn each selected clip into a short, using the format, layout, text and captions of the vertical studio. In the stacked layout each clip goes on top." />
              </Grid>

              <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <CheckBox x:Name="ReencodeCheckBox"
                          Content="Re-encode for exact cuts"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Slower, but cuts land exactly on the chosen times. Without it, cuts snap to nearby keyframes." />
                <Button Grid.Column="1" x:Name="SplitButton" Classes="accent action-button" Content="Export selected" Click="ExportSelected_Click" />
              </Grid>
            </Grid>
          </Border>
        </Grid>

        <!-- Centre: the player -->
        <Border Grid.Column="2" Classes="panel">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
              <RadioButton x:Name="VerticalModeRadio"
                           Classes="segment"
                           GroupName="PreviewMode"
                           Content="Vertical studio"
                           IsChecked="True"
                           IsCheckedChanged="PreviewMode_Changed" />
              <RadioButton Grid.Column="1"
                           x:Name="ClipModeRadio"
                           Classes="segment"
                           GroupName="PreviewMode"
                           Content="Clip preview"
                           IsCheckedChanged="PreviewMode_Changed" />
            </Grid>

            <controls:PreviewCanvas Grid.Row="1" x:Name="PreviewSurface" />

            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto,64" ColumnSpacing="10">
              <Button x:Name="PlayPauseButton" Classes="icon-button" Click="PlayPause_Click" ToolTip.Tip="Play or pause (Space)" AutomationProperties.Name="Play or pause">
                <Panel>
                  <Path x:Name="PlayIcon" Data="M 0,0 L 10,6 L 0,12 Z" Fill="#E5ECF7" Margin="2,0,0,0" />
                  <Path x:Name="PauseIcon" Data="M 0,0 H 3.5 V 12 H 0 Z M 6.5,0 H 10 V 12 H 6.5 Z" Fill="#E5ECF7" IsVisible="False" />
                </Panel>
              </Button>
              <controls:SeekBar Grid.Column="1" x:Name="PositionBar" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" x:Name="TimeText" Text="00:00 / 00:00" FontSize="12" Foreground="#C4CEDC" VerticalAlignment="Center" />
              <Button Grid.Column="3" x:Name="MuteButton" Classes="icon-button flat" Click="Mute_Click" ToolTip.Tip="Mute the preview" AutomationProperties.Name="Mute the preview">
                <Panel Width="16" Height="12">
                  <Path Data="M 0,4 H 3 L 7,0.5 V 11.5 L 3,8 H 0 Z" Fill="#C4CEDC" />
                  <Path x:Name="VolumeOnIcon" Data="M 9.5,3 C 11.2,4.6 11.2,7.4 9.5,9 M 11.8,1 C 14.8,3.9 14.8,8.1 11.8,11" Stroke="#C4CEDC" StrokeThickness="1.3" />
                  <Path x:Name="VolumeOffIcon" Data="M 10,3.5 L 15,8.5 M 15,3.5 L 10,8.5" Stroke="#E8394A" StrokeThickness="1.4" IsVisible="False" />
                </Panel>
              </Button>
              <controls:SeekBar Grid.Column="4" x:Name="VolumeBar" Value="1" VerticalAlignment="Center" ToolTip.Tip="Preview volume" />
            </Grid>
          </Grid>
        </Border>

        <!-- Right: settings for what is being previewed, and the activity log -->
        <Grid Grid.Column="4" x:Name="RightColumn" RowDefinitions="*,Auto" RowSpacing="12">
          <Border Classes="panel">
            <Panel>
              <Grid x:Name="VerticalPanel" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                <TextBlock x:Name="StudioTitleText" Classes="section" Text="SHORT  ·  9:16  ·  1080 × 1920" />

                <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="5">
                  <RadioButton x:Name="LayoutTabRadio"
                               Classes="segment"
                               GroupName="StudioTab"
                               Padding="2,6"
                               FontSize="12"
                               Content="Layout"
                               IsChecked="True"
                               IsCheckedChanged="StudioTab_Changed" />
                  <RadioButton Grid.Column="1"
                               x:Name="CaptionsTabRadio"
                               Classes="segment"
                               GroupName="StudioTab"
                               Padding="2,6"
                               FontSize="12"
                               Content="Captions"
                               IsCheckedChanged="StudioTab_Changed"
                               ToolTip.Tip="Turn the speech of a clip into captions, correct the text, and choose how the captions look" />
                  <RadioButton Grid.Column="2"
                               x:Name="TextTabRadio"
                               Classes="segment"
                               GroupName="StudioTab"
                               Padding="2,6"
                               FontSize="12"
                               Content="Text"
                               IsCheckedChanged="StudioTab_Changed"
                               ToolTip.Tip="Write a title or a hook over the short" />
                  <RadioButton Grid.Column="3"
                               x:Name="EffectsTabRadio"
                               Classes="segment"
                               GroupName="StudioTab"
                               Padding="2,6"
                               FontSize="12"
                               Content="Effects"
                               IsCheckedChanged="StudioTab_Changed"
                               ToolTip.Tip="Give the short a colour look, slow it down or speed it up, add a wave or a shake, and fade it in and out" />
                </Grid>

                <Panel Grid.Row="2">
                <ScrollViewer x:Name="LayoutTab" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10" Margin="0,0,10,0">
                <TextBlock Classes="label" Text="Format" Margin="0,0,0,-2" />
                <ComboBox x:Name="FormatBox"
                          MinHeight="46"
                          SelectionChanged="Format_Changed"
                          ToolTip.Tip="The shape and size of the exported short"
                          AutomationProperties.Name="Format of the short">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="views:FormatChoice">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding Title}" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#7C8BA3" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Grid x:Name="CustomSizeRow" ColumnDefinitions="*,Auto,*" ColumnSpacing="8" IsVisible="False">
                  <NumericUpDown x:Name="CustomWidthBox"
                                 Minimum="240"
                                 Maximum="4096"
                                 Increment="2"
                                 Value="1080"
                                 FormatString="0"
                                 ShowButtonSpinner="False"
                                 ValueChanged="CustomSize_Changed"
                                 ToolTip.Tip="Width in pixels"
                                 AutomationProperties.Name="Width in pixels" />
                  <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" Foreground="#AEB8C7" />
                  <NumericUpDown Grid.Column="2"
                                 x:Name="CustomHeightBox"
                                 Minimum="240"
                                 Maximum="4096"
                                 Increment="2"
                                 Value="1920"
                                 FormatString="0"
                                 ShowButtonSpinner="False"
                                 ValueChanged="CustomSize_Changed"
                                 ToolTip.Tip="Height in pixels"
                                 AutomationProperties.Name="Height in pixels" />
                </Grid>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                  <RadioButton x:Name="LayoutStackedRadio"
                               Classes="segment"
                               GroupName="VerticalLayout"
                               Content="Stacked"
                               IsChecked="True"
                               IsCheckedChanged="Layout_Changed"
                               ToolTip.Tip="Two clips, one under the other" />
                  <RadioButton Grid.Column="1"
                               x:Name="LayoutFillRadio"
                               Classes="segment"
                               GroupName="VerticalLayout"
                               Content="Fill"
                               IsCheckedChanged="Layout_Changed"
                               ToolTip.Tip="One clip, cropped to fill the whole frame" />
                  <RadioButton Grid.Column="2"
                               x:Name="LayoutBlurRadio"
                               Classes="segment"
                               GroupName="VerticalLayout"
                               Content="Blur"
                               IsCheckedChanged="Layout_Changed"
                               ToolTip.Tip="The whole clip over a blurred copy of itself" />
                </Grid>

                <Border Classes="slot-row">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border Width="11" Height="17" BorderBrush="#9CB7FF" BorderThickness="1.2" CornerRadius="2" VerticalAlignment="Center">
                      <Border x:Name="TopSlotIconFill" VerticalAlignment="Top" Height="7" Background="#9CB7FF" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock x:Name="TopSlotTitle" Text="Top clip" FontSize="11" Foreground="#7C8BA3" TextTrimming="CharacterEllipsis" />
                      <TextBlock x:Name="TopSlotText" Text="Drag a clip here" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="ClearTopButton" Classes="icon-button flat" Click="ClearTop_Click" ToolTip.Tip="Remove this clip" AutomationProperties.Name="Remove the top clip">
                      <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="#AEB8C7" StrokeThickness="1.4" />
                    </Button>
                  </Grid>
                </Border>

                <Border x:Name="BottomSlotRow" Classes="slot-row">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border Width="11" Height="17" BorderBrush="#9CB7FF" BorderThickness="1.2" CornerRadius="2" VerticalAlignment="Center">
                      <Border VerticalAlignment="Bottom" Height="7" Background="#9CB7FF" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                      <TextBlock x:Name="BottomSlotTitle" Text="Bottom clip" FontSize="11" Foreground="#7C8BA3" TextTrimming="CharacterEllipsis" />
                      <TextBlock x:Name="BottomSlotText" Text="Drag a clip here" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="ClearBottomButton" Classes="icon-button flat" Click="ClearBottom_Click" ToolTip.Tip="Remove this clip" AutomationProperties.Name="Remove the bottom clip">
                      <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="#AEB8C7" StrokeThickness="1.4" />
                    </Button>
                  </Grid>
                </Border>

                <Button x:Name="SwapSlotsButton"
                        Classes="action-button compact"
                        Content="Swap top and bottom"
                        HorizontalAlignment="Stretch"
                        Click="SwapSlots_Click" />

                <TextBlock Classes="label" Text="Sound from" />
                <UniformGrid Rows="1" Margin="0,0,-6,0">
                  <RadioButton x:Name="AudioTopRadio" Classes="segment" GroupName="VerticalAudio" Content="Top" IsChecked="True" Margin="0,0,6,0" IsCheckedChanged="Audio_Changed" />
                  <RadioButton x:Name="AudioBottomRadio" Classes="segment" GroupName="VerticalAudio" Content="Bottom" Margin="0,0,6,0" IsCheckedChanged="Audio_Changed" />
                  <RadioButton x:Name="AudioMixRadio" Classes="segment" GroupName="VerticalAudio" Content="Both" Margin="0,0,6,0" IsCheckedChanged="Audio_Changed" />
                  <RadioButton x:Name="AudioMuteRadio" Classes="segment" GroupName="VerticalAudio" Content="Mute" Margin="0,0,6,0" IsCheckedChanged="Audio_Changed" />
                </UniformGrid>

                <TextBlock x:Name="StudioHintText" Classes="hint" />
                </StackPanel>
                </ScrollViewer>

                <!-- Captions: where the words come from, the words themselves, and how they look -->
                <ScrollViewer x:Name="CaptionsTab" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="False">
                  <StackPanel Spacing="10" Margin="0,0,10,0">
                    <CheckBox x:Name="CaptionsEnabledBox"
                              Content="Add captions to the short"
                              IsCheckedChanged="CaptionsEnabled_Changed"
                              ToolTip.Tip="Burns the captions into the exported short. When exporting many shorts, each one gets captions for its own speech." />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                      <Button x:Name="GenerateCaptionsButton"
                              Classes="action-button compact"
                              Content="Generate captions"
                              HorizontalAlignment="Stretch"
                              Click="GenerateCaptions_Click"
                              ToolTip.Tip="Listens to the clip and writes down what is said. This runs on your computer; nothing is uploaded." />
                      <Button Grid.Column="1"
                              x:Name="ImportCaptionsButton"
                              Classes="action-button compact"
                              Content="Import .srt"
                              Click="ImportCaptions_Click"
                              ToolTip.Tip="Use a subtitle file made for the source video (.srt or .vtt) instead of speech recognition" />
                    </Grid>

                    <Grid ColumnDefinitions="5*,7*" ColumnSpacing="6">
                      <ComboBox x:Name="CaptionLanguageBox"
                                ToolTip.Tip="The language spoken in the clip"
                                AutomationProperties.Name="Spoken language">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="captions:SpeechLanguage">
                            <TextBlock Text="{Binding Name}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <ComboBox Grid.Column="1"
                                x:Name="CaptionModelBox"
                                SelectionChanged="CaptionModel_Changed"
                                ToolTip.Tip="How carefully to listen. More accurate models are bigger downloads and take longer."
                                AutomationProperties.Name="Recognition quality">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="captions:SpeechModel">
                            <TextBlock Text="{Binding Title}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </Grid>

                    <Grid x:Name="CaptionSlotRow" ColumnDefinitions="Auto,*,*" ColumnSpacing="6">
                      <TextBlock Text="Speech from" FontSize="12" Foreground="#AEB8C7" VerticalAlignment="Center" Margin="0,0,2,0" />
                      <RadioButton Grid.Column="1" x:Name="CaptionTopRadio" Classes="segment" GroupName="CaptionSlot" Content="Top clip" IsChecked="True" IsCheckedChanged="CaptionSlot_Changed" />
                      <RadioButton Grid.Column="2" x:Name="CaptionBottomRadio" Classes="segment" GroupName="CaptionSlot" Content="Bottom clip" IsCheckedChanged="CaptionSlot_Changed" />
                    </Grid>

                    <TextBlock x:Name="CaptionStatusText" Classes="hint" />

                  <!-- The text has a height of its own, so the look below it is always within reach. -->
                  <ListBox x:Name="CaptionLinesList"
                           MaxHeight="170"
                           Classes="caption-lines"
                           ItemsSource="{Binding CaptionLines}"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           AutomationProperties.Name="Caption text">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="views:CaptionLineItem">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="2">
                          <Button Classes="time-chip"
                                  Content="{Binding TimeText}"
                                  Click="CaptionLineTime_Click"
                                  ToolTip.Tip="Jump to this line"
                                  AutomationProperties.Name="Jump to this line" />
                          <TextBox Grid.Column="1"
                                   Classes="caption-line"
                                   Text="{Binding Text}"
                                   LostFocus="CaptionLine_LostFocus"
                                   KeyDown="CaptionLine_KeyDown"
                                   AutomationProperties.Name="Caption text" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                    <TextBlock Classes="section" Text="CAPTION STYLE" Margin="0,6,0,0" />
                    <TextBlock x:Name="StyleOffHintText"
                               Classes="hint"
                               Text="Captions are off, so the canvas shows none. Tick the box at the top to see the style you pick."
                               IsVisible="False" />

                    <ListBox x:Name="CaptionStyleList"
                             Classes="style-tiles"
                             ItemsSource="{Binding CaptionStyleTiles}"
                             SelectionChanged="CaptionStyle_Changed"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Caption style">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="views:CaptionStyleTile">
                          <Border CornerRadius="5" ClipToBounds="True" ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                            <Panel>
                              <Image Source="{Binding Sample}" Height="50" Stretch="UniformToFill" />
                              <TextBlock Text="{Binding Name}"
                                         FontSize="10"
                                         Foreground="#C4CEDC"
                                         Margin="6,3"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Top" />
                            </Panel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Classes="label" Text="Position" />
                    <UniformGrid Rows="1" Margin="0,0,-6,0">
                      <RadioButton x:Name="CaptionPositionTopRadio" Classes="segment" GroupName="CaptionPosition" Content="Top" Margin="0,0,6,0" IsCheckedChanged="CaptionPosition_Changed" />
                      <RadioButton x:Name="CaptionPositionMiddleRadio" Classes="segment" GroupName="CaptionPosition" Content="Middle" Margin="0,0,6,0" IsCheckedChanged="CaptionPosition_Changed" ToolTip.Tip="The middle of the frame, or the divider when two clips are stacked" />
                      <RadioButton x:Name="CaptionPositionBottomRadio" Classes="segment" GroupName="CaptionPosition" Content="Bottom" IsChecked="True" Margin="0,0,6,0" IsCheckedChanged="CaptionPosition_Changed" />
                    </UniformGrid>

                    <Grid ColumnDefinitions="Auto,*,40" ColumnSpacing="8">
                      <TextBlock Text="Size" FontSize="12" Foreground="#AEB8C7" VerticalAlignment="Center" />
                      <Slider Grid.Column="1"
                              x:Name="CaptionSizeSlider"
                              Minimum="60"
                              Maximum="160"
                              Value="100"
                              TickFrequency="5"
                              IsSnapToTickEnabled="True"
                              VerticalAlignment="Center"
                              ValueChanged="CaptionSize_Changed"
                              AutomationProperties.Name="Caption size" />
                      <TextBlock Grid.Column="2" x:Name="CaptionSizeText" Text="100%" FontSize="12" Foreground="#C4CEDC" VerticalAlignment="Center" TextAlignment="Right" />
                    </Grid>

                    <TextBlock x:Name="CaptionAccentLabel" Classes="label" Text="Colour" />
                    <WrapPanel x:Name="CaptionAccentPanel" Orientation="Horizontal" />

                    <CheckBox x:Name="CaptionCapsBox"
                              Content="ALL CAPS"
                              IsCheckedChanged="CaptionCaps_Changed" />
                  </StackPanel>
                </ScrollViewer>

                <!-- Text: a title or a hook written over the short -->
                <ScrollViewer x:Name="TextTab" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="False">
                  <StackPanel Spacing="10" Margin="0,0,10,0">
                    <TextBox x:Name="OverlayTextBox"
                             Height="58"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontSize="12.5"
                             Watermark="Write a title or a hook..."
                             TextChanged="OverlayText_Changed"
                             ToolTip.Tip="The text shown over the short. Press Enter to start a new line. It is added to every short you export until you clear this box."
                             AutomationProperties.Name="Text on the short" />
                    <TextBlock Classes="hint" Text="Drag the text on the canvas to place it." Margin="0,-4,0,0" />

                    <ListBox x:Name="TextStyleList"
                             Classes="style-tiles"
                             ItemsSource="{Binding TextStyleTiles}"
                             SelectionChanged="TextStyle_Changed"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Text style">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="views:TextStyleTile">
                          <Border CornerRadius="5" ClipToBounds="True" ToolTip.Tip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                            <Panel>
                              <Image Source="{Binding Sample}" Height="46" Stretch="UniformToFill" />
                              <TextBlock Text="{Binding Name}"
                                         FontSize="10"
                                         Foreground="#C4CEDC"
                                         Margin="6,3"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Top" />
                            </Panel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid ColumnDefinitions="52,*" ColumnSpacing="8">
                      <TextBlock Text="Position" FontSize="12" Foreground="#AEB8C7" VerticalAlignment="Center" />
                      <UniformGrid Grid.Column="1" Rows="1" Margin="0,0,-6,0">
                        <RadioButton x:Name="TextPositionTopRadio" Classes="segment" GroupName="TextPosition" Content="Top" IsChecked="True" Margin="0,0,6,0" IsCheckedChanged="TextPosition_Changed" />
                        <RadioButton x:Name="TextPositionMiddleRadio" Classes="segment" GroupName="TextPosition" Content="Middle" Margin="0,0,6,0" IsCheckedChanged="TextPosition_Changed" ToolTip.Tip="The middle of the frame, or the divider when two clips are stacked" />
                        <RadioButton x:Name="TextPositionBottomRadio" Classes="segment" GroupName="TextPosition" Content="Bottom" Margin="0,0,6,0" IsCheckedChanged="TextPosition_Changed" />
                      </UniformGrid>
                    </Grid>

                    <Grid ColumnDefinitions="52,*,40" ColumnSpacing="8">
                      <TextBlock Text="Size" FontSize="12" Foreground="#AEB8C7" VerticalAlignment="Center" />
                      <Slider Grid.Column="1"
                              x:Name="TextSizeSlider"
                              Minimum="50"
                              Maximum="200"
                              Value="100"
                              VerticalAlignment="Center"
                              ValueChanged="TextSize_Changed"
                              ToolTip.Tip="Scrolling over the text on the canvas resizes it as well"
                              AutomationProperties.Name="Text size" />
                      <TextBlock Grid.Column="2" x:Name="TextSizeText" Text="100%" FontSize="12" Foreground="#C4CEDC" VerticalAlignment="Center" TextAlignment="Right" />
                    </Grid>

                    <Grid ColumnDefinitions="52,*" ColumnSpacing="8">
                      <TextBlock Text="Show" FontSize="12" Foreground="#AEB8C7" VerticalAlignment="Center" />
                      <UniformGrid Grid.Column="1" Rows="1" Margin="0,0,-6,0">
                        <RadioButton x:Name="TextShowAlwaysRadio" Classes="segment" GroupName="TextShow" Content="Always" IsChecked="True" Margin="0,0,6,0" IsCheckedChanged="TextShow_Changed" ToolTip.Tip="The text stays for the whole short" />
                        <RadioButton x:Name="TextShowThreeRadio" Classes="segment" GroupName="TextShow" Content="First 3 s" Margin="0,0,6,0" IsCheckedChanged="TextShow_Changed" ToolTip.Tip="The text opens the short, then fades away after 3 seconds" />
                        <RadioButton x:Name="TextShowFiveRadio" Classes="segment" GroupName="TextShow" Content="First 5 s" Margin="0,0,6,0" IsCheckedChanged="TextShow_Changed" ToolTip.Tip="The text opens the short, then fades away after 5 seconds" />
                      </UniformGrid>
                    </Grid>

                    <TextBlock x:Name="TextAccentLabel" Classes="label" Text="Text colour" Margin="0,0,0,-2" />
                    <WrapPanel x:Name="TextAccentPanel" Orientation="Horizontal" />
                  </StackPanel>
                </ScrollViewer>

                <!-- Effects: the colour look of the short, and how it opens and closes -->
                <ScrollViewer x:Name="EffectsTab" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsVisible="False">
                  <StackPanel Spacing="10" Margin="0,0,10,0">
                    <TextBlock Classes="label" Text="Look" Margin="0,0,0,-2" />
                    <UniformGrid x:Name="LookPanel" Columns="3" Margin="0,0,-6,-6" />

                    <TextBlock Classes="label" Text="Speed" />
                    <UniformGrid x:Name="SpeedPanel" Rows="1" Margin="0,0,-6,0" />

                    <TextBlock Classes="label" Text="Effect" />
                    <UniformGrid x:Name="EffectPanel" Columns="3" Margin="0,0,-6,-6" />

                    <TextBlock Classes="label" Text="Transitions" />
                    <CheckBox x:Name="FadeInBox"
                              Content="Fade in at the start"
                              IsCheckedChanged="Fade_Changed"
                              ToolTip.Tip="The short opens from black, with its sound rising" />
                    <CheckBox x:Name="FadeOutBox"
                              Content="Fade out at the end"
                              IsCheckedChanged="Fade_Changed"
                              ToolTip.Tip="The short closes to black, with its sound falling" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <TextBlock Text="Length" FontSize="12" Foreground="#AEB8C7" VerticalAlignment="Center" />
                      <UniformGrid Grid.Column="1" Rows="1" Margin="0,0,-6,0">
                        <RadioButton x:Name="FadeShortRadio" Classes="segment" GroupName="FadeLength" Content="Short" Margin="0,0,6,0" IsCheckedChanged="FadeLength_Changed" ToolTip.Tip="0.3 seconds" />
                        <RadioButton x:Name="FadeMediumRadio" Classes="segment" GroupName="FadeLength" Content="Medium" IsChecked="True" Margin="0,0,6,0" IsCheckedChanged="FadeLength_Changed" ToolTip.Tip="0.6 seconds" />
                        <RadioButton x:Name="FadeLongRadio" Classes="segment" GroupName="FadeLength" Content="Long" Margin="0,0,6,0" IsCheckedChanged="FadeLength_Changed" ToolTip.Tip="1 second" />
                      </UniformGrid>
                    </Grid>

                    <TextBlock Classes="hint" Text="Looks, speed and effects play on the canvas as they will be exported. Sound slows down and speeds up with the picture and keeps its pitch. Fades show while the short is playing." />
                  </StackPanel>
                </ScrollViewer>
                </Panel>

                <Button Grid.Row="3"
                        x:Name="ExportShortButton"
                        Classes="accent action-button"
                        Content="Export this short"
                        HorizontalAlignment="Stretch"
                        Click="ExportShort_Click" />
              </Grid>

              <StackPanel x:Name="ClipPanel" Spacing="10" IsVisible="False">
                <TextBlock Classes="section" Text="CLIP PREVIEW" />
                <StackPanel Spacing="2">
                  <TextBlock x:Name="ClipTitleText" Text="No clip loaded" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock x:Name="ClipRangeText" Classes="hint" Text="Press play on a clip in the list to watch it here." />
                </StackPanel>

                <TextBlock Classes="label" Text="Trim" />
                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6">
                  <Button x:Name="TrimStartButton"
                          Classes="action-button compact"
                          Content="Start here"
                          HorizontalAlignment="Stretch"
                          Click="TrimStart_Click"
                          ToolTip.Tip="Make the clip begin at the current position" />
                  <Button Grid.Column="1"
                          x:Name="TrimEndButton"
                          Classes="action-button compact"
                          Content="End here"
                          HorizontalAlignment="Stretch"
                          Click="TrimEnd_Click"
                          ToolTip.Tip="Make the clip end at the current position" />
                  <Button Grid.Column="2"
                          x:Name="TrimResetButton"
                          Classes="action-button compact"
                          Content="Reset"
                          Click="TrimReset_Click"
                          ToolTip.Tip="Restore the full clip" />
                </Grid>
                <TextBlock Classes="hint" Text="Pause where the clip should begin or end, then press Start here or End here." />

                <TextBlock Classes="label" Text="Use in a vertical short" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                  <Button x:Name="ClipToTopButton" Classes="action-button compact" Content="As top clip" HorizontalAlignment="Stretch" Click="ClipToTop_Click" />
                  <Button Grid.Column="1" x:Name="ClipToBottomButton" Classes="action-button compact" Content="As bottom clip" HorizontalAlignment="Stretch" Click="ClipToBottom_Click" />
                </Grid>
              </StackPanel>
            </Panel>
          </Border>

          <Border Grid.Row="1" Classes="panel">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
              <TextBlock Classes="section" Text="ACTIVITY" />
              <ProgressBar Grid.Row="1" x:Name="ExportProgress" Minimum="0" Maximum="100" Height="8" MinHeight="8" CornerRadius="4" />
              <TextBox Grid.Row="2"
                       x:Name="LogBox"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       FontSize="12"
                       ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <!-- The thumbnail that follows the pointer while a clip is dragged to the canvas -->
    <Canvas IsHitTestVisible="False">
      <Border x:Name="DragGhost"
              IsVisible="False"
              Padding="6"
              CornerRadius="8"
              Background="#E6151922"
              BorderBrush="#3B82F6"
              BorderThickness="1.5">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Width="80" Height="45" CornerRadius="4" ClipToBounds="True" Background="#0B0F16">
            <Image x:Name="DragGhostImage" Stretch="UniformToFill" />
          </Border>
          <TextBlock x:Name="DragGhostText" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0" />
        </StackPanel>
      </Border>
    </Canvas>

    <Border Classes="resize-vertical" Background="Transparent" Height="8" VerticalAlignment="Top" PointerPressed="ResizeTop_PointerPressed" />
    <Border Classes="resize-vertical" Background="Transparent" Height="8" VerticalAlignment="Bottom" PointerPressed="ResizeBottom_PointerPressed" />
    <Border Classes="resize-horizontal" Background="Transparent" Width="8" HorizontalAlignment="Left" PointerPressed="ResizeLeft_PointerPressed" />
    <Border Classes="resize-horizontal" Background="Transparent" Width="8" HorizontalAlignment="Right" PointerPressed="ResizeRight_PointerPressed" />
    <Border Classes="resize-nwse" Background="Transparent" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" PointerPressed="ResizeTopLeft_PointerPressed" />
    <Border Classes="resize-nesw" Background="Transparent" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" PointerPressed="ResizeTopRight_PointerPressed" />
    <Border Classes="resize-nesw" Background="Transparent" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" PointerPressed="ResizeBottomLeft_PointerPressed" />
    <Border Classes="resize-nwse" Background="Transparent" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" PointerPressed="ResizeBottomRight_PointerPressed" />
  </Grid>
</Window>
